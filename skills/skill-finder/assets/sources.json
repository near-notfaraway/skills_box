{
  "version": 1,
  "sources": [
    {
      "id": "skills-sh",
      "type": "http",
      "enabled": true,
      "url": "https://skills.sh/api/search",
      "site": "https://skills.sh",
      "docs": "https://github.com/vercel-labs/skills/blob/main/src/find.ts",
      "items_path": "skills",
      "fields": {"name": "name", "id": "id", "repository": "source", "installs": "installs"},
      "listing_template": "https://skills.sh/{id}",
      "metric_scopes": {"installs": "skill"}
    },
    {
      "id": "skillsmp",
      "type": "http",
      "enabled": true,
      "url": "https://skillsmp.com/api/v1/skills/search",
      "site": "https://skillsmp.com",
      "docs": "https://skillsmp.com/docs/api",
      "items_path": "data.skills",
      "limit_param": "limit",
      "optional_auth_env": "SKILLSMP_API_KEY",
      "fields": {
        "name": "name", "id": "id", "description": "description", "author": "author",
        "repository": "githubUrl", "url": "skillUrl", "stars": "stars",
        "reported_updated_at": "updatedAt"
      },
      "metric_scopes": {"stars": "repository", "reported_updated_at": "source_reported"}
    },
    {
      "id": "clawhub",
      "type": "http",
      "enabled": true,
      "url": "https://clawhub.ai/api/v1/search",
      "site": "https://clawhub.ai",
      "docs": "https://github.com/openclaw/clawhub/blob/main/docs/http-api.md",
      "items_path": "results",
      "limit_param": "limit",
      "registry": "https://clawhub.ai",
      "fields": {
        "name": "slug", "id": "id", "display_name": "displayName", "description": "summary",
        "publisher": "ownerHandle", "url": "canonicalUrl", "repository": "links.source",
        "downloads": "native.skill.stats.downloads", "installs": "native.skill.stats.installs",
        "stars": "native.skill.stats.stars", "versions": "native.skill.stats.versions",
        "reported_updated_at": "updatedAt"
      },
      "metric_scopes": {
        "downloads": "skill", "installs": "skill", "stars": "skill",
        "versions": "skill", "reported_updated_at": "source_reported"
      }
    },
    {
      "id": "lobehub",
      "type": "agent",
      "enabled": true,
      "url": "https://lobehub.com/skills",
      "docs": "https://lobehub.com/skills/skill.md",
      "cli": ["npx", "--registry=https://registry.npmjs.org", "--yes", "@lobehub/market-cli@latest", "skills", "search", "--q", "{query}", "--output", "json"],
      "items_path": "items",
      "fields": {
        "name": "name", "id": "identifier", "description": "description",
        "author": "author", "repository": "github.url", "installs": "installCount",
        "stars": "github.stars", "reported_updated_at": "updatedAt"
      },
      "listing_template": "https://lobehub.com/skills/{id}",
      "metric_scopes": {"installs": "skill", "stars": "repository", "reported_updated_at": "source_reported"},
      "note": "Use the official CLI with an existing identity; if registration is needed, use public website search for discovery."
    },
    {
      "id": "skillhub",
      "type": "agent",
      "enabled": true,
      "url": "https://skillhub.cloud.tencent.com/skills",
      "docs": "https://skillhub.cn/install/skillhub.md",
      "cli": ["skillhub", "search", "{query}"],
      "note": "Use an existing official CLI or public website search. Read current detail pages to distinguish skills, plugins and paid services."
    },
    {
      "id": "github",
      "type": "agent",
      "enabled": true,
      "url": "https://github.com",
      "docs": "https://cli.github.com/manual/gh_search_code",
      "cli": ["gh", "search", "code", "{query}", "--filename", "SKILL.md", "--limit", "10", "--json", "path,repository,url"],
      "note": "Code search requires authentication. Use repository discovery and site search if unavailable; verify files through gh."
    }
  ]
}
